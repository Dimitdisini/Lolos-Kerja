# =========================================================================
# LOLOS KERJA - ENVIRONMENT VARIABLES (Aligned with ANTIGRAVITY-BACKEND-EXECUTION.md 3.3)
# =========================================================================

# Database & Auth (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# LLM Engine (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL_FAST=claude-3-5-haiku-latest
LLM_MODEL_STRONG=claude-3-5-sonnet-latest
LLM_MODE=live                            # live | fixture (tes)

# Transactional Email Engine
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...
MAIL_FROM_DOMAIN=lamaran.loloskerja.id
MAIL_TRANSPORT=resend                    # resend | capture (tes: simpan ke tabel, tidak keluar)

# Security & Cron
CRON_SECRET=                             # WAJIB, server menolak start jika kosong (B2)
APP_URL=                                 # WAJIB, tanpa default (B9)

# Job Sourcing & Scraping
APIFY_TOKEN=apify_api_...
APIFY_BUDGET_USD_MONTH=3

# Payment Gateway
PAYMENT_PROVIDER=manual                  # manual | midtrans | xendit
PAYMENT_SERVER_KEY=

# Global Caps & Limits
GLOBAL_DAILY_CAP=150
